# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # OAuth client secret only
APP_BASE_URL=             # Canonical HTTPS origin, e.g. https://cinekin.example
VITE_SITE_URL=            # HTTPS origin injected at build time into canonical, social metadata, robots and sitemap
SESSION_SECRET=           # Dedicated random key (32+ chars) for session/OAuth transaction signing
ENCRYPTION_KEY=           # Dedicated random key (32+ chars) for AES-GCM data encryption
ADMIN_PASSWORD=           # Optional password-based administrator login

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)
KIMI_TOKEN_ISSUER=        # Optional exact issuer expected in Kimi access tokens
KIMI_OAUTH_PKCE=true      # Keep true; false is only a compatibility fallback

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# ── Proxy, rate limiting and MySQL pool ────────────────────────
TRUST_PROXY=true          # Only behind a trusted reverse proxy such as Vercel
TRUST_PROXY_HOPS=1        # Number of trusted proxy hops, counted from the right
RATE_LIMIT_STORE=database # Shared MySQL counters in production; memory for local tests only
DATABASE_POOL_LIMIT=3
DATABASE_CONNECT_TIMEOUT_MS=10000

# ── Staging rehearsal (operators only; never commit values) ───
STAGING_ENVIRONMENT=      # Must be exactly "staging"
STAGING_DATABASE_URL=     # Read-only source connection for the rehearsal
STAGING_RESTORE_DATABASE_URL= # Empty, isolated MySQL database used for restore
STAGING_BASE_URL=         # Deployed HTTPS staging origin; same as APP_BASE_URL/VITE_SITE_URL
STAGING_BACKUP_PASSPHRASE= # Dedicated random passphrase (32+ chars; store separately)
STAGING_BACKUP_DIR=artifacts/staging-backups
STAGING_REHEARSAL_ALLOW_APPLY=0 # Set to 1 only for the explicit rehearsal command
